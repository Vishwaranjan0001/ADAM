# Copy this file to .env for local overrides. Never commit .env.
# Docker Compose has safe development defaults, so .env is optional.

# Hardware Profile: MACBOOK_AIR_8GB | DEV_SERVER | GOV_PRODUCTION
ADAM_PROFILE=DEV_SERVER

# Database Configuration (Default: Native local SQLite)
# Docker Compose: postgresql+psycopg://adam:change-me@postgres:5432/adam
# Native local development: sqlite:///adam.db
DATABASE_URL=postgresql+psycopg://adam:change-me@postgres:5432/adam

# Storage Directory for Immutable Originals, Rendered Pages & Models
STORAGE_DIR=.adam_storage

# Storage Cache Ceiling (MB) — Enforced by `adam dev cache-clean`
CACHE_CEILING_MB=2048

# Model Inference Configuration
# Maximum context token ceiling (2k-4k on MacBook Air 8GB)
MAX_CONTEXT_TOKENS=4096
# Maximum concurrent model generations (Strictly 1 on MacBook Air 8GB)
MAX_CONCURRENT_GENERATIONS=1
# Model ID registered in ModelRegistry
PRIMARY_MODEL_ID=qwen2.5-3b-instruct-q4
ADAM_MODEL_BACKEND=ollama
# For native development use localhost. In Docker, Compose defaults to the
# host's Ollama endpoint on macOS/Windows; override it on Linux if needed.
OLLAMA_HOST=http://host.docker.internal:11434

# Security & Governance
# Required outside local development. Use a long, unique random value.
SIGNING_SECRET=replace-with-a-long-random-development-secret
MAX_FILE_SIZE_BYTES=209715200
REQUEST_TIMEOUT_SECONDS=30.0

# API Server & UI Bindings
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=3000
